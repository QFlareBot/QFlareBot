{
  "name": "@qqbot/runtime",
  "version": "0.1.0",
  "description": "QQ 机器人 Workers 运行时：Webhook 网关、事件分发、插件上下文注入与管理 API",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qqbot/api": "workspace:*",
    "@qqbot/sdk": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
