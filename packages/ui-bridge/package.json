{
  "name": "@qqbot/ui-bridge",
  "version": "0.1.0",
  "description": "插件页面与管理面板之间的桥：设计 token、postMessage 协议、页面端客户端",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": ["dist", "src/tokens.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./host": { "types": "./dist/host.d.ts", "import": "./dist/host.js" },
      "./tokens.css": "./dist/tokens.css"
    }
  }
}
