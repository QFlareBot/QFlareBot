{
  "name": "@qqbot/ui",
  "version": "0.1.1",
  "description": "qqbot 管理面板（Vue 3），构建产物打包为可嵌入 Worker 的资源表",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "scripts": {
    "dev": "cp ../ui-bridge/src/tokens.css public/tokens.css && vite",
    "build": "mkdir -p public && cp ../ui-bridge/src/tokens.css public/tokens.css && vite build && node scripts/pack.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qqbot/ui-bridge": "workspace:*",
    "lucide-vue-next": "^0.544.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.7"
  }
}
