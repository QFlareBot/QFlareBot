{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qqbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // 绑定只写名字不写 ID：wrangler 会自动创建缺失的资源、复用已存在的同名资源，
  // 这样每次部署都以本文件为准，不会丢绑定
  "kv_namespaces": [{ "binding": "KV" }],
  "d1_databases": [{ "binding": "DB", "database_name": "qqbot" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "qqbot-artifacts" }],

  // 运行时只注册这一个 Cron Trigger，再按各插件声明的表达式分发
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true },

  // 生产环境请改用自定义域名（大陆网络访问 *.workers.dev 不稳定）：
  // "routes": [{ "pattern": "bot.example.com", "custom_domain": true }],
  "workers_dev": true
}
